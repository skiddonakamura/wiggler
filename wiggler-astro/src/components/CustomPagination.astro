---
// Custom pagination for weapon pages
// Shows cross-links between guide, progression, and endgame sections

const currentPath = Astro.url.pathname.replace(/\/$/, '');

const weaponPageMatch = currentPath.match(
	/^\/(\w+)\/weapons\/([\w_]+)\/(guide|progression|endgame|data)$/
);

interface PaginationLink {
	label: string;
	href: string;
}

let links: PaginationLink[] = [];

if (weaponPageMatch) {
	const [, game, weapon, currentSection] = weaponPageMatch;

	const sectionConfig = [
		{ slug: 'guide', label: 'Guide' },
		{ slug: 'progression', label: 'Progression' },
		{ slug: 'endgame', label: 'Endgame Sets' },
	];

	links = sectionConfig
		.filter((s) => s.slug !== currentSection)
		.map((s) => ({
			label: s.label,
			href: `/${game}/weapons/${weapon}/${s.slug}/`,
		}));
}
---

{
	links.length > 0 && (
		<div class="pagination-links print:hidden">
			{links.map((link) => (
				<a href={link.href}>
					<span class="link-title">{link.label}</span>
				</a>
			))}
		</div>
	)
}

<style>
	@layer starlight.core {
		.pagination-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
			gap: 1rem;
		}

		a {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			width: 100%;
			flex-basis: calc(50% - 0.5rem);
			flex-grow: 1;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.5rem;
			padding: 1rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			box-shadow: var(--sl-shadow-md);
			overflow-wrap: anywhere;
		}

		a:hover {
			border-color: var(--sl-color-gray-2);
		}

		.link-title {
			color: var(--sl-color-white);
			font-size: var(--sl-text-2xl);
			line-height: var(--sl-line-height-headings);
		}
	}
</style>
