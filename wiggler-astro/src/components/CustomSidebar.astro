---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import type { SidebarEntry } from '@astrojs/starlight/utils/routing/types';
import {
	gameOverviewHrefs,
	parseGameOverviewPath,
	parseWeaponPagePath,
} from '../utils/siteConfig';

const { sidebar } = Astro.locals.starlightRoute;
const currentGameOverview = parseGameOverviewPath(Astro.url.pathname);
const currentWeaponPage = parseWeaponPagePath(Astro.url.pathname);

let filteredSidebar: SidebarEntry[];

if (currentGameOverview) {
	// Game overview page: show only the 3 game links
	filteredSidebar = sidebar
		.filter((entry): entry is Extract<SidebarEntry, { type: 'group' }> => entry.type === 'group')
		.map((group) => {
			const overviewLink = group.entries.find(
				(e) => e.type === 'link' && Object.values(gameOverviewHrefs).includes(e.href)
			);
			return {
				type: 'link' as const,
				label: group.label,
				href: overviewLink?.type === 'link' ? overviewLink.href : '#',
				isCurrent: overviewLink?.type === 'link' ? overviewLink.isCurrent : false,
				badge: undefined,
				attrs: {},
			};
		});
} else if (currentWeaponPage) {
	// Weapon page: show game overview link + current weapon's sections
	const { game } = currentWeaponPage;

	// Find the game group that contains the current page
	const gameGroup = sidebar.find(
		(entry) =>
			entry.type === 'group' &&
			entry.entries.some(
				(e) => e.type === 'link' && e.href === gameOverviewHrefs[game]
			)
	);

	if (gameGroup && gameGroup.type === 'group') {
		// Game overview link
		const gameLink: SidebarEntry = {
			type: 'link',
			label: gameGroup.label,
			href: gameOverviewHrefs[game]!,
			isCurrent: false,
			badge: undefined,
			attrs: {},
		};

		// Find the weapon subgroup that contains the current page
		const weaponGroup = gameGroup.entries.find(
			(entry) =>
				entry.type === 'group' &&
				entry.entries.some((e) => e.type === 'link' && e.isCurrent)
		);

		if (weaponGroup && weaponGroup.type === 'group') {
			filteredSidebar = [
				gameLink,
				{ ...weaponGroup, collapsed: false },
			];
		} else {
			filteredSidebar = [gameLink];
		}
	} else {
		filteredSidebar = sidebar;
	}
} else {
	// Fallback: show full sidebar
	filteredSidebar = sidebar;
}
---

<SidebarPersister>
	<SidebarSublist sublist={filteredSidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
