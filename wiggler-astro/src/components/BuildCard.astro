---
interface Props {
	title: string;
	tier: 'Meta' | 'Comfort' | 'Budget' | 'Meme';
	audience: string;
	calculator?: string;
}

const { title, tier, audience, calculator } = Astro.props;
---

<section class="build-card" aria-labelledby={`${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-title`}>
	<header>
		<div>
			<p class="tier">{tier} build</p>
			<h3 id={`${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-title`}>{title}</h3>
		</div>
		<span>{audience}</span>
	</header>
	<div class="content"><slot /></div>
	{calculator && <p class="calculator"><a href={calculator} target="_blank" rel="noreferrer">Open in set builder <span aria-hidden="true">↗</span></a></p>}
</section>

<style>
	.build-card { background: linear-gradient(135deg, color-mix(in srgb, var(--sl-color-bg-nav) 86%, var(--sl-color-accent)), var(--sl-color-bg-nav)); border: 1px solid var(--sl-color-gray-5); border-radius: .8rem; margin: 1.5rem 0; overflow: hidden; }
	header { align-items: start; border-bottom: 1px solid var(--sl-color-gray-5); display: flex; gap: 1rem; justify-content: space-between; padding: 1.1rem 1.25rem; }
	.tier { color: var(--sl-color-text-accent); font-size: .75rem; font-weight: 700; letter-spacing: .08em; margin: 0; text-transform: uppercase; }
	h3 { margin: .2rem 0 0; }
	header span { background: var(--sl-color-accent-low); border-radius: 99px; color: var(--sl-color-text-accent); font-size: .8rem; padding: .25rem .55rem; white-space: nowrap; }
	.content { padding: .2rem 1.25rem; }
	.content :global(h4) { font-size: .86rem; letter-spacing: .06em; margin-bottom: .35rem; text-transform: uppercase; }
	.calculator { border-top: 1px solid var(--sl-color-gray-5); margin: 0; padding: .8rem 1.25rem; }
	.calculator a { font-weight: 700; }
</style>
