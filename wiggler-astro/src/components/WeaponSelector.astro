---
import { Image } from 'astro:assets';
import { processWeaponData } from '../utils/weapons';
import type { WeaponContent } from '../utils/weapons';
import { sectionConfigs, type GameSlug } from '../utils/siteConfig';

interface Props {
	game: GameSlug;
}

const { game } = Astro.props;

const weaponContentModules = {
	wilds: import.meta.glob('../content/docs/wilds/weapons/*/*.{md,mdx}', { eager: true }),
	rise: import.meta.glob('../content/docs/rise/weapons/*/*.{md,mdx}', { eager: true }),
	world: import.meta.glob('../content/docs/world/weapons/*/*.{md,mdx}', { eager: true }),
} satisfies Record<GameSlug, Record<string, WeaponContent>>;

const weapons = processWeaponData(Object.values(weaponContentModules[game]));

const sectionDescriptions = {
	guide: 'Learn the moveset and core gameplan.',
	progression: 'Build a loadout for the story.',
	endgame: 'Choose a polished late-game set.',
	data: 'Reference frame data and mechanics.',
} as const;
---

<weapon-selector>
	<section class="weapon-selector" aria-label="Weapon guides">
		<div class="weapon-tabs" role="tablist" aria-label="Weapons">
			{weapons.map((weapon, index) => (
				<button
					id={`weapon-tab-${game}-${weapon.name}`}
					class="weapon-tab"
					data-weapon-tab={weapon.name}
					role="tab"
					aria-label={weapon.displayName}
					aria-selected="false"
					aria-controls={`weapon-panel-${game}-${weapon.name}`}
					tabindex={index === 0 ? 0 : -1}
				>
					<Image src={weapon.icon} alt="" />
				</button>
			))}
		</div>

		{weapons.map((weapon) => (
			<section
				id={`weapon-panel-${game}-${weapon.name}`}
				class="weapon-panel"
				data-weapon-panel={weapon.name}
				role="tabpanel"
				aria-labelledby={`weapon-tab-${game}-${weapon.name}`}
				hidden
			>
				<div class="panel-heading">
					<Image src={weapon.icon} alt="" />
					<div>
						<h3>{weapon.displayName}</h3>
					</div>
				</div>

				<div class="section-links">
					{sectionConfigs.map((section) => (
						<a class="section-link" href={`/${game}/weapons/${weapon.name}/${section.slug}/`}>
							<span class="section-label">{section.label}</span>
							<span class="section-description">{sectionDescriptions[section.slug]}</span>
							<span class="section-arrow" aria-hidden="true">→</span>
						</a>
					))}
				</div>
			</section>
		))}
	</section>
</weapon-selector>

<script>
	class WeaponSelector extends HTMLElement {
		private tabs: HTMLButtonElement[] = [];
		private panels: HTMLElement[] = [];

		connectedCallback() {
			this.tabs = Array.from(this.querySelectorAll('[data-weapon-tab]'));
			this.panels = Array.from(this.querySelectorAll('[data-weapon-panel]'));

			this.tabs.forEach((tab) => {
				tab.addEventListener('click', this.handleClick);
				tab.addEventListener('keydown', this.handleKeydown);
			});
		}

		disconnectedCallback() {
			this.tabs.forEach((tab) => {
				tab.removeEventListener('click', this.handleClick);
				tab.removeEventListener('keydown', this.handleKeydown);
			});
		}

		private handleClick = (event: Event) => {
			this.selectTab(event.currentTarget as HTMLButtonElement, true);
		};

		private handleKeydown = (event: KeyboardEvent) => {
			const currentTab = event.currentTarget as HTMLButtonElement;
			const currentIndex = this.tabs.indexOf(currentTab);
			let nextIndex: number | null = null;

			switch (event.key) {
				case 'ArrowRight':
					nextIndex = (currentIndex + 1) % this.tabs.length;
					break;
				case 'ArrowLeft':
					nextIndex = (currentIndex - 1 + this.tabs.length) % this.tabs.length;
					break;
				case 'ArrowDown':
					nextIndex = Math.min(currentIndex + this.columnCount(), this.tabs.length - 1);
					break;
				case 'ArrowUp':
					nextIndex = Math.max(currentIndex - this.columnCount(), 0);
					break;
				case 'Home':
					nextIndex = 0;
					break;
				case 'End':
					nextIndex = this.tabs.length - 1;
					break;
			}

			if (nextIndex === null) return;

			event.preventDefault();
			const nextTab = this.tabs[nextIndex];
			this.selectTab(nextTab, false);
			nextTab.focus();
		};

		private columnCount() {
			const firstRowTop = this.tabs[0]?.getBoundingClientRect().top;
			if (firstRowTop === undefined) return 1;

			const nextRowIndex = this.tabs.findIndex(
				(tab, index) => index > 0 && tab.getBoundingClientRect().top > firstRowTop + 1
			);

			return nextRowIndex === -1 ? this.tabs.length : nextRowIndex;
		}

		private selectTab(selectedTab: HTMLButtonElement, shouldScroll: boolean) {
			const weapon = selectedTab.dataset.weaponTab;
			if (!weapon) return;

			this.tabs.forEach((tab) => {
				const isSelected = tab === selectedTab;
				tab.setAttribute('aria-selected', String(isSelected));
				tab.tabIndex = isSelected ? 0 : -1;
			});

			this.panels.forEach((panel) => {
				panel.hidden = panel.dataset.weaponPanel !== weapon;
			});

			if (shouldScroll) {
				this.querySelector(`[data-weapon-panel="${weapon}"]`)?.scrollIntoView({
					behavior: 'smooth',
					block: 'nearest',
				});
			}
		}
	}

	if (!customElements.get('weapon-selector')) {
		customElements.define('weapon-selector', WeaponSelector);
	}
</script>

<style>
	weapon-selector {
		display: block;
		margin: 2.5rem 0;
	}

	.weapon-selector {
		--selector-border: color-mix(in srgb, var(--sl-color-gray-4), transparent 30%);
	}

	.panel-heading h3 {
		border: 0;
		color: var(--sl-color-white);
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0;
		padding: 0;
	}

	.weapon-tabs {
		box-sizing: border-box;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		max-width: 48rem;
		margin-inline: auto;
		padding: 0 1rem 1rem;
	}

	.weapon-tab {
		align-items: center;
		background: var(--sl-color-gray-5);
		border: 1px solid transparent;
		border-radius: 0.6rem;
		color: var(--sl-color-gray-1);
		cursor: pointer;
		display: flex;
		font: inherit;
		justify-content: center;
		margin: 0;
		aspect-ratio: 1;
		padding: 0.45rem;
		transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 150ms ease;
		width: calc((100% - 1.5rem) / 4);
	}

	.weapon-tab:hover {
		background: var(--sl-color-gray-4);
		transform: translateY(-1px);
	}

	.weapon-tab[aria-selected='true'] {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}

	.weapon-tab:focus-visible,
	.section-link:focus-visible {
		outline: 3px solid var(--sl-color-accent-high);
		outline-offset: 2px;
	}

	.weapon-tab img {
		height: clamp(2rem, 6vw, 2.75rem);
		margin: 0;
		object-fit: contain;
		width: clamp(2rem, 6vw, 2.75rem);
	}

	.weapon-panel {
		border-top: 1px solid var(--selector-border);
		padding: clamp(1.25rem, 3vw, 2rem);
	}

	.panel-heading {
		align-items: center;
		display: flex;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
	}

	.panel-heading img {
		height: 3.5rem;
		margin: 0;
		object-fit: contain;
		width: 3.5rem;
	}

	.section-links {
		display: grid;
		gap: 0.6rem;
	}

	.section-link {
		background: var(--sl-color-black);
		border: 1px solid var(--selector-border);
		border-radius: 0.65rem;
		color: inherit;
		display: grid;
		gap: 0.15rem 1rem;
		grid-template-columns: 1fr auto;
		padding: 0.9rem 1rem;
		text-decoration: none;
		transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
	}

	.section-link:hover {
		background: var(--sl-color-gray-5);
		border-color: var(--sl-color-accent);
		transform: translateX(2px);
	}

	.section-label {
		color: var(--sl-color-white);
		font-weight: 700;
	}

	.section-description {
		color: var(--sl-color-gray-2);
		font-size: 0.9rem;
		grid-column: 1;
	}

	.section-arrow {
		align-self: center;
		color: var(--sl-color-accent);
		font-size: 1.25rem;
		grid-column: 2;
		grid-row: 1 / span 2;
	}

	@media (min-width: 32rem) {
		.weapon-tab {
			width: calc((100% - 2rem) / 5);
		}
	}

	@media (min-width: 48rem) {
		.weapon-tabs {
			padding-inline: clamp(1.25rem, 4vw, 2.5rem);
		}

		.weapon-tab {
			width: calc((100% - 2.5rem) / 6);
		}

		.section-links {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 70rem) {
		.weapon-tab {
			width: calc((100% - 3rem) / 7);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.weapon-tab,
		.section-link {
			transition: none;
		}
	}
</style>
