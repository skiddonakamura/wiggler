---
import { controlSchemes } from '../utils/controlSchemes';

const controlSchemeLabels = {
	switch: 'Nintendo Switch',
	playstation: 'PlayStation',
	xbox: 'Xbox',
	keyboard: 'Mouse & Keyboard',
} as const;
---

<control-scheme-switcher>
	<fieldset class="scheme-fieldset">
		<legend>Show inputs as</legend>
		<div class="scheme-options">
			{controlSchemes.map((scheme) => (
				<span class="scheme-option">
					<input
						type="radio"
						id={`control-scheme-${scheme}`}
						name="control-scheme"
						value={scheme}
						checked={scheme === 'switch'}
					/>
					<label for={`control-scheme-${scheme}`}>{controlSchemeLabels[scheme]}</label>
				</span>
			))}
		</div>
	</fieldset>
</control-scheme-switcher>

<script>
	import {
		CONTROL_SCHEME_STORAGE_KEY,
		type ControlScheme,
		dispatchControlSchemeChange,
		getStoredControlScheme,
		isControlScheme,
		storeControlScheme,
	} from '../utils/controlSchemes';

	const switcher = document.querySelector('control-scheme-switcher');
	const inputs = Array.from(
		switcher?.querySelectorAll<HTMLInputElement>('input[name="control-scheme"]') ?? [],
	);

	function applyScheme(scheme: ControlScheme, persist = false) {
		document.documentElement.dataset.controlScheme = scheme;
		inputs.forEach((input) => {
			input.checked = input.value === scheme;
		});

		if (persist) {
			storeControlScheme(scheme);
		}

		dispatchControlSchemeChange(scheme);
	}

	applyScheme(getStoredControlScheme());

	switcher?.addEventListener('change', (event) => {
		const input = event.target;
		if (input instanceof HTMLInputElement && isControlScheme(input.value)) {
			applyScheme(input.value, true);
		}
	});

	window.addEventListener('storage', (event) => {
		if (event.key === CONTROL_SCHEME_STORAGE_KEY && event.newValue && isControlScheme(event.newValue)) {
			applyScheme(event.newValue);
		}
	});
</script>

<style>
	control-scheme-switcher {
		display: block;
		border-bottom: 1px solid var(--sl-color-gray-5);
		margin: 0 0 1.75rem;
		padding: 0 0 1rem;
	}

	.scheme-fieldset {
		border: 0;
		margin: 0;
		padding: 0;
	}

	legend {
		color: var(--sl-color-gray-3);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		margin: 0 0 0.55rem;
		padding: 0;
		text-transform: uppercase;
	}

	.scheme-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.scheme-option {
		position: relative;
	}

	.scheme-option input {
		block-size: 1px;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		inline-size: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
	}

	.scheme-option label {
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999rem;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		display: block;
		font-size: 0.9rem;
		line-height: 1.2;
		padding: 0.4rem 0.75rem;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.scheme-option label:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}

	.scheme-option input:checked + label {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}

	.scheme-option input:focus-visible + label {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
</style>
