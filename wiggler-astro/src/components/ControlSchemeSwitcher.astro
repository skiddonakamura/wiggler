---
import { controlSchemes } from '../utils/controlSchemes';

const controlSchemeLabels = {
	switch: 'Nintendo Switch',
	playstation: 'PlayStation',
	xbox: 'Xbox',
	keyboard: 'Mouse & Keyboard',
} as const;
---

<control-scheme-switcher>
	<label for="control-scheme-select" class="scheme-label">
		Select Input:
	</label>
	<select id="control-scheme-select" class="scheme-select">
		{controlSchemes.map((scheme) => (
			<option value={scheme}>{controlSchemeLabels[scheme]}</option>
		))}
	</select>
</control-scheme-switcher>

<script>
	import {
		CONTROL_SCHEME_STORAGE_KEY,
		type ControlScheme,
		dispatchControlSchemeChange,
		getStoredControlScheme,
	} from '../utils/controlSchemes';

	class ControlSchemeSwitcher extends HTMLElement {
		private readonly select: HTMLSelectElement | null = null;
		private readonly handleChange = () => {
			if (!this.select) {
				return;
			}

			const scheme = this.select.value as ControlScheme;
			localStorage.setItem(CONTROL_SCHEME_STORAGE_KEY, scheme);
			dispatchControlSchemeChange(scheme);
		};

		constructor() {
			super();
			this.select = this.querySelector('#control-scheme-select');
		}

		connectedCallback() {
			if (!this.select) {
				return;
			}

			this.select.value = getStoredControlScheme();
			this.select.addEventListener('change', this.handleChange);
			this.handleChange();
		}

		disconnectedCallback() {
			this.select?.removeEventListener('change', this.handleChange);
		}
	}

	customElements.define('control-scheme-switcher', ControlSchemeSwitcher);
</script>

<style>
	control-scheme-switcher {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		margin: 0 auto 1.5rem auto;
		padding: 1rem;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--sl-border-radius);
	}

	.scheme-label {
		font-weight: 600;
		color: var(--sl-color-white);
		font-size: 0.95rem;
	}

	.scheme-select {
		padding: 0.5rem 0.75rem;
		background: var(--sl-color-gray-5);
		color: var(--sl-color-white);
		border: 1px solid var(--sl-color-gray-4);
		border-radius: calc(var(--sl-border-radius) - 2px);
		font-size: 0.95rem;
		cursor: pointer;
		transition: all 0.2s ease;
		margin-top: 0.5rem;
	}

	.scheme-select:hover {
		background: var(--sl-color-gray-4);
		border-color: var(--sl-color-accent);
	}

	.scheme-select:focus {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	@media (max-width: 640px) {
		.scheme-select {
			width: 100%;
		}
	}
</style>
