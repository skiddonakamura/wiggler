---
import { getGameControlMapping } from '../utils/gameControls';
import { getControlMapping } from '../utils/controlsMapping';

interface Props {
	control?: string;
	game?: string;
	action?: string;
}

const { control, game, action } = Astro.props;
const fallbackControl = control ?? action ?? 'N/A';
const mapping =
	(game && action ? getGameControlMapping(game, action) : undefined) ??
	(control ? getControlMapping(control) : undefined);

const controlValues = {
	switch: mapping?.switch ?? fallbackControl,
	playstation: mapping?.playstation ?? fallbackControl,
	xbox: mapping?.xbox ?? fallbackControl,
	keyboard: mapping?.keyboard ?? fallbackControl,
};
const defaultIconPath = mapping?.icons?.switch;
---

<control-display
	class="control-display"
	data-control={control}
	data-game={game}
	data-action={action}
><kbd class="control-key control-key--switch">{defaultIconPath ? <img src={defaultIconPath} alt={controlValues.switch} class="control-icon" /> : controlValues.switch}</kbd><kbd class="control-key control-key--playstation">{controlValues.playstation}</kbd><kbd class="control-key control-key--xbox">{controlValues.xbox}</kbd><kbd class="control-key control-key--keyboard">{controlValues.keyboard}</kbd></control-display>

<script>
	import { getGameControlMapping } from '../utils/gameControls';
	import { getControlMapping } from '../utils/controlsMapping';
	import {
		CONTROL_SCHEME_EVENT,
		type ControlScheme,
		getStoredControlScheme,
		isControlScheme,
	} from '../utils/controlSchemes';

	function getMapping(display: HTMLElement) {
		const { action, control, game } = display.dataset;
		return (
			(game && action ? getGameControlMapping(game, action) : undefined) ??
			(control ? getControlMapping(control) : undefined)
		);
	}

	function getFallbackValue(display: HTMLElement) {
		return display.dataset.control ?? display.dataset.action ?? 'N/A';
	}

	function renderDisplay(display: HTMLElement, scheme: ControlScheme) {
		const mapping = getMapping(display);
		const value = mapping?.[scheme] ?? getFallbackValue(display);
		const iconPath = mapping?.icons?.[scheme];
		const renderToken = String(Number(display.dataset.renderToken ?? '0') + 1);
		display.dataset.renderToken = renderToken;

		if (!iconPath) {
			const key = document.createElement('kbd');
			key.className = 'control-key control-key--active';
			key.textContent = value;
			display.replaceChildren(key);
			return;
		}

		const icon = new Image();
		icon.alt = value;
		icon.className = 'control-icon';
		icon.decoding = 'async';
		icon.addEventListener(
			'load',
			() => {
				if (display.dataset.renderToken !== renderToken) return;

				const key = document.createElement('kbd');
				key.className = 'control-key control-key--active';
				key.append(icon);
				display.replaceChildren(key);
			},
			{ once: true },
		);
		icon.src = iconPath;
	}

	function renderDisplays(scheme: ControlScheme) {
		document.querySelectorAll<HTMLElement>('.control-display').forEach((display) => {
			renderDisplay(display, scheme);
		});
	}

	renderDisplays(getStoredControlScheme());

	window.addEventListener(CONTROL_SCHEME_EVENT, (event) => {
		const { detail } = event as CustomEvent<{ scheme?: string }>;
		if (detail?.scheme && isControlScheme(detail.scheme)) {
			renderDisplays(detail.scheme);
		}
	});
</script>
