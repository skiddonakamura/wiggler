---
interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<div class="dropdown-card">
	<details>
		<summary class="summary-with-slot">
			<slot name="trigger" />
		</summary>
		<div class="dropdown-content">
			<slot />
		</div>
	</details>
</div>

<style>
	.dropdown-card {
		border: 1px solid var(--sl-color-accent-low);
		border-radius: var(--sl-border-radius-md);
		padding: 1.5rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
	}

	details {
		cursor: pointer;
	}

	.summary-with-slot {
		user-select: none;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.summary-with-slot:hover {
		opacity: 0.9;
	}

	.summary-with-slot::marker {
		content: none;
	}

	.dropdown-content {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-accent-low);
	}
</style>

